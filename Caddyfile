# Caddy сам получает и продлевает TLS-сертификат Let's Encrypt для домена
# из переменной {$DOMAIN} (см. .env) — единственное условие: домен должен
# уже указывать A-записью на IP этого сервера, иначе Let's Encrypt не
# сможет подтвердить владение доменом (HTTP-01 challenge на порту 80).
#
# /upload (страница загрузки сметы, сессия 2026-08-18) закрыта паролем —
# это реальная запись в боевой Pyrus-аккаунт, открывать всем в интернете
# нельзя. "/" (сам вебхук, его дёргает только Pyrus) — без пароля: Pyrus
# не умеет посылать Basic Auth, а его запросы и так проверяются подписью
# внутри webhook_server.py (см. докстринг там).
#
# Хэш пароля ниже — bcrypt, сам пароль в открытом виде нигде в репозитории
# не хранится (см. CLAUDE.md, там же — как посмотреть/сменить).
{$DOMAIN} {
	basic_auth /upload* {
		snab $2a$14$tFpLYwtFXaGMsZVppodl4OL1QEJjaUmuM3Z2.gfHwmNqQ7VPUHsm.
	}
	reverse_proxy webhook:8000
}
