# Скопировать в .env (сам .env — в .gitignore, реальные секреты в git не попадают)
# и заполнить настоящими значениями.

PYRUS_LOGIN=pyrus_demo@outlook.com
PYRUS_SECURITY_KEY=
# Secret key бота с pyrus.com/t#bots (НЕ security_key выше) — нужен только
# сервису webhook, для проверки подписи входящих запросов от Pyrus.
PYRUS_WEBHOOK_SECRET=

# Как часто (в секундах) сервис cron прогоняет ботов. 900 = 15 минут.
CRON_INTERVAL_SECONDS=900

# Домен, указывающий A-записью на IP этого сервера — нужен сервису caddy
# для автоматического HTTPS-сертификата. Пока домена нет — просто не
# запускайте сервисы webhook/caddy (docker compose up -d cron).
DOMAIN=
